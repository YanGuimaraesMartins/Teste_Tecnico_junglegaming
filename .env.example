# Pirate Battle — Environment Variables

# API base URL (all calls intercepted by MSW in dev/test/prod)
# VITE_API_URL=/api

# MSW scenario (default: success)
# Options: success | empty | paginated | slow | variable-latency | out-of-order |
#          timeout | network-error | http-error-4xx | http-error-5xx |
#          ranking-fail | history-fail | match-timeout-recover | match-unavailable-recover
# VITE_MSW_SCENARIO=success

# Enable MSW in production build
# VITE_MSW_ENABLED=true
